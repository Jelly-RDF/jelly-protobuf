    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:notable jellyt:featureShouldLevel ;
    mf:action <triples_rdf_1_1/neg_022/in.jelly> .

<triples_rdf_1_1/neg_023> a jellyt:TestNegative, jellyt:TestRdf12FromJelly ;
    mf:name "A name lookup entry with an identifier larger than the table size." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#prefix-name-and-datatype-lookup-entries> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:notable jellyt:featureShouldLevel ;
    mf:action <triples_rdf_1_1/neg_023/in.jelly> .

<triples_rdf_1_1/neg_024> a jellyt:TestNegative, jellyt:TestRdf12FromJelly ;
    mf:name "A packed name entry whose last value falls outside the table (ids 127, 128, 129 in a table of 128)." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#prefix-name-and-datatype-lookup-entries> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:notable jellyt:featureShouldLevel ;
    mf:action <triples_rdf_1_1/neg_024/in.jelly> .

<triples_rdf_1_1/neg_025> a jellyt:TestNegative, jellyt:TestRdf12FromJelly ;
    mf:name "A prefix lookup entry with an identifier larger than the table size." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#prefix-name-and-datatype-lookup-entries> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:notable jellyt:featureShouldLevel ;
    mf:action <triples_rdf_1_1/neg_025/in.jelly> .

<triples_rdf_1_1/neg_026> a jellyt:TestNegative, jellyt:TestRdf12FromJelly ;
    mf:name "A column refers to a prefix identifier outside the prefix table." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#iris-in-columns> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:notable jellyt:featureShouldLevel ;
    mf:action <triples_rdf_1_1/neg_026/in.jelly> .

<triples_rdf_1_1/neg_027> a jellyt:TestNegative, jellyt:TestRdf12FromJelly ;
    mf:name "A column refers to a name that was never defined (name_id 0 at the start of a column means 1, and the name table is empty)." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#prefix-name-and-datatype-lookup-entries> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
