    mf:action <triples_rdf_1_1/neg_027/in.jelly> .

<triples_rdf_1_1/neg_028> a jellyt:TestNegative, jellyt:TestRdf12FromJelly ;
    mf:name "A column refers to a name identifier outside the name table." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#iris-in-columns> ;
