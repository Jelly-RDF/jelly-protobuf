    mf:action <triples_rdf_1_1/neg_011/in.jelly> .

<triples_rdf_1_1/neg_012> a jellyt:TestNegative, jellyt:TestRdf12FromJelly ;
    mf:name "max_name_table_size 127, below the minimum of 128." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#stream-options> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:notable jellyt:featureShouldLevel ;
    mf:action <triples_rdf_1_1/neg_012/in.jelly> .

<triples_rdf_1_1/neg_013> a jellyt:TestNegative, jellyt:TestRdf12FromJelly ;
    mf:name "max_name_table_size not set (0), in a frame with only the stream options." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#stream-options> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:notable jellyt:featureShouldLevel ;
    mf:action <triples_rdf_1_1/neg_013/in.jelly> .

<triples_rdf_1_1/neg_014> a jellyt:TestNegative, jellyt:TestRdf12FromJelly ;
    mf:name "max_name_table_size 10000000. Consumers should reject lookup sizes larger than their limit (recommended default 16384)." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#stream-options> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:notable jellyt:featureShouldLevel ;
    mf:action <triples_rdf_1_1/neg_014/in.jelly> .

<triples_rdf_1_1/neg_015> a jellyt:TestNegative, jellyt:TestRdf12FromJelly ;
    mf:name "max_prefix_table_size 10000000. Consumers should reject lookup sizes larger than their limit (recommended default 4096)." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#stream-options> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:notable jellyt:featureShouldLevel ;
    mf:action <triples_rdf_1_1/neg_015/in.jelly> .

<triples_rdf_1_1/neg_016> a jellyt:TestNegative, jellyt:TestRdf12FromJelly ;
    mf:name "max_datatype_table_size 10000000. Consumers should reject lookup sizes larger than their limit (recommended default 256)." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#stream-options> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:notable jellyt:featureShouldLevel ;
    mf:action <triples_rdf_1_1/neg_016/in.jelly> .

<triples_rdf_1_1/neg_017> a jellyt:TestNegative, jellyt:TestRdf12FromJelly ;
    mf:name "A frame with two rows: the stream options twice." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#stream-frames> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:notable jellyt:featureShouldLevel ;
    mf:action <triples_rdf_1_1/neg_017/in.jelly> .

<triples_rdf_1_1/neg_018> a jellyt:TestNegative, jellyt:TestRdf12FromJelly ;
    mf:name "A frame with two rows: the stream options, and a name entry row of the row layout (Jelly-RDF 1.1)." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#stream-frames> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
