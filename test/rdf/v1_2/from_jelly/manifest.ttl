    mf:result <triples_rdf_1_2/pos_013/out.nt> .

<triples_rdf_1_2/pos_014> a jellyt:TestPositive, jellyt:TestRdf12FromJelly ;
    mf:name "A column of triple terms only, with no kinds." ;
