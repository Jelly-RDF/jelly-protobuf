    mf:action <triples_rdf_1_1/neg_018/in.jelly> .

<triples_rdf_1_1/neg_019> a jellyt:TestNegative, jellyt:TestRdf12FromJelly ;
    mf:name "A row with a triple (row layout, Jelly-RDF 1.1) in a stream with version tag 3." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#stream-frames> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:notable jellyt:featureShouldLevel ;
    mf:action <triples_rdf_1_1/neg_019/in.jelly> .

<triples_rdf_1_1/neg_020> a jellyt:TestNegative, jellyt:TestRdf12FromJelly ;
    mf:name "A row with a namespace declaration (row layout, Jelly-RDF 1.1) in a stream with version tag 3." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#stream-frames> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:notable jellyt:featureShouldLevel ;
    mf:action <triples_rdf_1_1/neg_020/in.jelly> .

<triples_rdf_1_1/neg_021> a jellyt:TestNegative, jellyt:TestRdf12FromJelly ;
    mf:name "A prefix lookup entry when the prefix lookup is disabled (max_prefix_table_size 0)." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#stream-options> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:notable jellyt:featureShouldLevel ;
    mf:action <triples_rdf_1_1/neg_021/in.jelly> .

<triples_rdf_1_1/neg_022> a jellyt:TestNegative, jellyt:TestRdf12FromJelly ;
    mf:name "A datatype lookup entry when the datatype lookup is disabled (max_datatype_table_size 0)." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#stream-options> ;
