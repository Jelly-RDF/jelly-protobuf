<quads_rdf_1_2/pos_001> a jellyt:TestPositive, jellyt:TestRdf12FromJelly ;
    mf:name "Common usage: triple terms in named graphs and in the default graph, over several frames." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#triple-terms> ;
