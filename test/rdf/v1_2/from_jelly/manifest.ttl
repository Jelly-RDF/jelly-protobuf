    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:requires jellyt:requirementRdf12 ;
    mf:notable jellyt:featureShouldLevel ;
    mf:action <triples_rdf_1_2/neg_012/in.jelly> .

<triples_rdf_1_2/neg_013> a jellyt:TestNegative, jellyt:TestRdf12FromJelly ;
    mf:name "A triple term refers to a name that was never defined." ;
