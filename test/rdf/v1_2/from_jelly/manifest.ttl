<triples_rdf_1_1/pos_001> a jellyt:TestPositive, jellyt:TestRdf12FromJelly ;
    mf:name "Typical graph: IRIs, language-tagged and typed literals. Prefix and datatype lookups enabled. Single frame." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#column-batches> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:action <triples_rdf_1_1/pos_001/in.jelly> ;
    mf:result <triples_rdf_1_1/pos_001/out.nt> .

<triples_rdf_1_1/pos_002> a jellyt:TestPositive, jellyt:TestRdf12FromJelly ;
    mf:name "Typical graph with the prefix lookup disabled. The names hold whole IRIs." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#stream-options> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:action <triples_rdf_1_1/pos_002/in.jelly> ;
