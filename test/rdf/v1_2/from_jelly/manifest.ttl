<quads_rdf_1_2_basic/pos_001> a jellyt:TestPositive, jellyt:TestRdf12FromJelly ;
    mf:name "Common usage: directional labels in named graphs, over several frames." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#base-direction> ;
