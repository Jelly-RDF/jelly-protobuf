    mf:result <triples_rdf_1_2/pos_015/out.nt> .

<triples_rdf_1_2/pos_016> a jellyt:TestPositive, jellyt:TestRdf12FromJelly ;
    mf:name "Common usage: reifiers with rdf:reifies and triple terms, with IRIs, literals, and nested triple terms, over several frames." ;
