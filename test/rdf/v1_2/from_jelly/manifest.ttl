    mf:action <messages/pos_013/in.jelly> ;
    mf:result (
        <messages/pos_013/out_000.nt>
        <messages/pos_013/out_001.nt>
    ) .

<messages/pos_014> a jellyt:TestPositive, jellyt:TestRdf12FromJelly ;
    mf:name "Lookup entries are kept from one message to the next." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#stream-types> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementMessages ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:action <messages/pos_014/in.jelly> ;
    mf:result (
        <messages/pos_014/out_000.nt>
        <messages/pos_014/out_001.nt>
    ) .

<messages/pos_015> a jellyt:TestPositive, jellyt:TestRdf12FromJelly ;
    mf:name "A blank node label used in two frames of the same message: the same blank node." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#blank-nodes> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementMessages ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:action <messages/pos_015/in.jelly> ;
    mf:result (
        <messages/pos_015/out_000.nt>
    ) .

<messages/pos_016> a jellyt:TestPositive, jellyt:TestRdf12FromJelly ;
    mf:name "Empty frames between the frames of a message." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#stream-frames> ;
