    mf:name "Two streams concatenated. The second segment restates the stream options (with other table sizes), and its lookup identifiers restart from 1." ;
    rdfs:comment "Blank node labels are not reset by the restated options: the label x in both segments is one blank node." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#restating-the-stream-options> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:action <triples_rdf_1_1/pos_022/in.jelly> ;
    mf:result <triples_rdf_1_1/pos_022/out.nt> .

<triples_rdf_1_1/pos_023> a jellyt:TestPositive, jellyt:TestRdf12FromJelly ;
    mf:name "Concatenated streams with other lookup settings: the first segment has no prefix lookup, the second has prefix and datatype lookups, and the third declares RDF 1.1." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#restating-the-stream-options> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:action <triples_rdf_1_1/pos_023/in.jelly> ;
    mf:result <triples_rdf_1_1/pos_023/out.nt> .

<triples_rdf_1_1/pos_024> a jellyt:TestPositive, jellyt:TestRdf12FromJelly ;
    mf:name "The stream options restated in a frame without a column batch, and then in a frame with one." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#restating-the-stream-options> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:action <triples_rdf_1_1/pos_024/in.jelly> ;
    mf:result <triples_rdf_1_1/pos_024/out.nt> .

<triples_rdf_1_1/pos_025> a jellyt:TestPositive, jellyt:TestRdf12FromJelly ;
    mf:name "Namespace declarations do not change the statements: two declarations, the second with its IRI inferred from the first (prefix_id 0 and name_id 0), an empty namespace name, and a name declared again." ;
    rdfs:comment "The IRIs of the namespace declarations are one IRI sequence: ex: is http://example.org/, the empty name is http://example.org/ns/ (prefix 1, name 9), and ex: is then http://example.org/a." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#namespace-declarations> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:action <triples_rdf_1_1/pos_025/in.jelly> ;
    mf:result <triples_rdf_1_1/pos_025/out.nt> .

<triples_rdf_1_1/pos_026> a jellyt:TestPositive, jellyt:TestRdf12FromJelly ;
    mf:name "A column batch with only namespace declarations (row_count 0), between two batches with statements." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#namespace-declarations> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:action <triples_rdf_1_1/pos_026/in.jelly> ;
    mf:result <triples_rdf_1_1/pos_026/out.nt> .

<triples_rdf_1_1/pos_027> a jellyt:TestPositive, jellyt:TestRdf12FromJelly ;
    mf:name "Namespace declarations without the prefix lookup: the IRI of the namespace is a whole name." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#namespace-declarations> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:action <triples_rdf_1_1/pos_027/in.jelly> ;
    mf:result <triples_rdf_1_1/pos_027/out.nt> .

<triples_rdf_1_1/pos_028> a jellyt:TestPositive, jellyt:TestRdf12FromJelly ;
    mf:name "Lookup identifiers continue across frames: an entry with id 0 in the second frame takes the next identifier." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#packed-lookup-entries> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:action <triples_rdf_1_1/pos_028/in.jelly> ;
    mf:result <triples_rdf_1_1/pos_028/out.nt> .

<triples_rdf_1_1/pos_029> a jellyt:TestPositive, jellyt:TestRdf12FromJelly ;
    mf:name "Packed entries with explicit identifiers: id 10 with two values, then id 0 continuing at 12." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#packed-lookup-entries> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:action <triples_rdf_1_1/pos_029/in.jelly> ;
    mf:result <triples_rdf_1_1/pos_029/out.nt> .

<triples_rdf_1_1/pos_030> a jellyt:TestPositive, jellyt:TestRdf12FromJelly ;
    mf:name "An entry overwritten in a later frame: the later frame sees the new value." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#prefix-name-and-datatype-lookup-entries> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:action <triples_rdf_1_1/pos_030/in.jelly> ;
    mf:result <triples_rdf_1_1/pos_030/out.nt> .

<triples_rdf_1_1/pos_031> a jellyt:TestPositive, jellyt:TestRdf12FromJelly ;
    mf:name "All lookup entries of a batch are applied before its columns: a name overwritten twice in one batch decodes to the last value." ;
    rdfs:comment "A producer must not write such a batch if the column is meant to refer to the first value (see the working set rule). A consumer must still decode it this way." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#the-working-set-of-a-batch> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:action <triples_rdf_1_1/pos_031/in.jelly> ;
    mf:result <triples_rdf_1_1/pos_031/out.nt> .

<triples_rdf_1_1/pos_032> a jellyt:TestPositive, jellyt:TestRdf12FromJelly ;
    mf:name "A name lookup entry at the largest identifier the table allows." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#stream-options> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:action <triples_rdf_1_1/pos_032/in.jelly> ;
    mf:result <triples_rdf_1_1/pos_032/out.nt> .

<triples_rdf_1_1/pos_033> a jellyt:TestPositive, jellyt:TestRdf12FromJelly ;
    mf:name "Lookup table sizes at the recommended default consumer limits: 16384 names, 4096 prefixes, 256 datatypes." ;
    rdfs:comment "Consumers may set lower limits than the recommended defaults, and then reject this stream." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#stream-options> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:notable jellyt:featureShouldLevel ;
    mf:action <triples_rdf_1_1/pos_033/in.jelly> ;
    mf:result <triples_rdf_1_1/pos_033/out.nt> .

<triples_rdf_1_1/pos_034> a jellyt:TestPositive, jellyt:TestRdf12FromJelly ;
    mf:name "IRI example from the specification: name_ids [0, 0, 1, 3], prefix_ids [1, 0, 0, 2]." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#iris-in-columns> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:action <triples_rdf_1_1/pos_034/in.jelly> ;
    mf:result <triples_rdf_1_1/pos_034/out.nt> .

<triples_rdf_1_1/pos_035> a jellyt:TestPositive, jellyt:TestRdf12FromJelly ;
    mf:name "prefix_ids with a single entry: every value uses that prefix." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#iris-in-columns> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:action <triples_rdf_1_1/pos_035/in.jelly> ;
    mf:result <triples_rdf_1_1/pos_035/out.nt> .

<triples_rdf_1_1/pos_036> a jellyt:TestPositive, jellyt:TestRdf12FromJelly ;
    mf:name "Empty prefix_ids with the prefix lookup enabled: no value has a prefix, the names hold whole IRIs." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#iris-in-columns> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:action <triples_rdf_1_1/pos_036/in.jelly> ;
    mf:result <triples_rdf_1_1/pos_036/out.nt> .

<triples_rdf_1_1/pos_037> a jellyt:TestPositive, jellyt:TestRdf12FromJelly ;
    mf:name "prefix_ids with one entry per value, starting with 0: the prefix inference state starts from \"no prefix\"." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#iris-in-columns> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:action <triples_rdf_1_1/pos_037/in.jelly> ;
    mf:result <triples_rdf_1_1/pos_037/out.nt> .

<triples_rdf_1_1/pos_038> a jellyt:TestPositive, jellyt:TestRdf12FromJelly ;
    mf:name "name_ids mixing explicit identifiers and 0 (previous + 1): [5, 0, 0, 2, 0] is 5, 6, 7, 2, 3." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#iris-in-columns> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:action <triples_rdf_1_1/pos_038/in.jelly> ;
    mf:result <triples_rdf_1_1/pos_038/out.nt> .

<triples_rdf_1_1/pos_039> a jellyt:TestPositive, jellyt:TestRdf12FromJelly ;
    mf:name "The name_id and prefix_id inference state resets at the start of every column." ;
    rdfs:comment "The subjects column ends at name 3 with prefix 2. The objects column still starts from name 0 and no prefix: its first name_id of 0 means name 1, and its first prefix_id of 0 means no prefix, not the prefix of the previous column." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#iris-in-columns> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:action <triples_rdf_1_1/pos_039/in.jelly> ;
    mf:result <triples_rdf_1_1/pos_039/out.nt> .

<triples_rdf_1_1/pos_040> a jellyt:TestPositive, jellyt:TestRdf12FromJelly ;
    mf:name "The name_id inference state resets at the start of every batch." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#iris-in-columns> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:action <triples_rdf_1_1/pos_040/in.jelly> ;
    mf:result <triples_rdf_1_1/pos_040/out.nt> .

<triples_rdf_1_1/pos_041> a jellyt:TestPositive, jellyt:TestRdf12FromJelly ;
    mf:name "An empty name: the IRI is equal to its prefix." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#iris-in-columns> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:action <triples_rdf_1_1/pos_041/in.jelly> ;
    mf:result <triples_rdf_1_1/pos_041/out.nt> .

<triples_rdf_1_1/pos_042> a jellyt:TestPositive, jellyt:TestRdf12FromJelly ;
    mf:name "Subjects, predicates, and objects with different prefixes, all IRIs inferred from 0." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#iris-in-columns> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:action <triples_rdf_1_1/pos_042/in.jelly> ;
    mf:result <triples_rdf_1_1/pos_042/out.nt> .

<triples_rdf_1_1/pos_043> a jellyt:TestPositive, jellyt:TestRdf12FromJelly ;
    mf:name "A column of simple literals: literal_kinds is empty." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#literals-in-columns> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:action <triples_rdf_1_1/pos_043/in.jelly> ;
    mf:result <triples_rdf_1_1/pos_043/out.nt> .

<triples_rdf_1_1/pos_044> a jellyt:TestPositive, jellyt:TestRdf12FromJelly ;
    mf:name "xsd:string literals encoded three ways: no literal kinds, a single literal kind referring to an xsd:string datatype entry, and one literal kind per value mixing 0 and that entry. All are the same simple literal." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#literals-in-columns> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:action <triples_rdf_1_1/pos_044/in.jelly> ;
    mf:result <triples_rdf_1_1/pos_044/out.nt> .

<triples_rdf_1_1/pos_045> a jellyt:TestPositive, jellyt:TestRdf12FromJelly ;
    mf:name "A column of literals with a single literal kind for the whole column: xsd:integer, then xsd:dateTime." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#literals-in-columns> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:action <triples_rdf_1_1/pos_045/in.jelly> ;
    mf:result <triples_rdf_1_1/pos_045/out.nt> .

<triples_rdf_1_1/pos_046> a jellyt:TestPositive, jellyt:TestRdf12FromJelly ;
    mf:name "A column of literals with one language tag for the whole column: a single literal kind of 2." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#literals-in-columns> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:action <triples_rdf_1_1/pos_046/in.jelly> ;
    mf:result <triples_rdf_1_1/pos_046/out.nt> .

<triples_rdf_1_1/pos_047> a jellyt:TestPositive, jellyt:TestRdf12FromJelly ;
    mf:name "A column of literals with one literal kind per value, mixing simple, typed, and language-tagged literals with different tags." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#literals-in-columns> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:action <triples_rdf_1_1/pos_047/in.jelly> ;
    mf:result <triples_rdf_1_1/pos_047/out.nt> .

<triples_rdf_1_1/pos_048> a jellyt:TestPositive, jellyt:TestRdf12FromJelly ;
    mf:name "Literal kind values: 0 is a simple literal, odd values 1, 3, 5 are datatypes 1, 2, 3, and even values 2, 4, 6 are language tags 0, 1, 2." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#literals-in-columns> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:action <triples_rdf_1_1/pos_048/in.jelly> ;
    mf:result <triples_rdf_1_1/pos_048/out.nt> .

<triples_rdf_1_1/pos_049> a jellyt:TestPositive, jellyt:TestRdf12FromJelly ;
    mf:name "Empty lexical forms, with a single literal kind and with one literal kind per value." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#literals-in-columns> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:action <triples_rdf_1_1/pos_049/in.jelly> ;
    mf:result <triples_rdf_1_1/pos_049/out.nt> .

<triples_rdf_1_1/pos_050> a jellyt:TestPositive, jellyt:TestRdf12FromJelly ;
    mf:name "langtag_directions with only 0 entries (no base direction) in a stream that declares RDF 1.1." ;
    rdfs:comment "Producers should leave langtag_directions empty instead, but a list of zeros is valid." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#literals-in-columns> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:action <triples_rdf_1_1/pos_050/in.jelly> ;
    mf:result <triples_rdf_1_1/pos_050/out.nt> .

<triples_rdf_1_1/pos_051> a jellyt:TestPositive, jellyt:TestRdf12FromJelly ;
    mf:name "An objects column with values of several term types: kinds says which list holds each run value. Six values need two bytes of kinds." ;
    rdfs:comment "kinds = [0x18, 0x00]: IRI, blank node, literal, IRI in the first byte, then IRI, IRI. The IRIs are decoded from name_ids [0, 0, 4, 0]: names 1, 2, 4, 5." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#term-types> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:action <triples_rdf_1_1/pos_051/in.jelly> ;
    mf:result <triples_rdf_1_1/pos_051/out.nt> .

<triples_rdf_1_1/pos_052> a jellyt:TestPositive, jellyt:TestRdf12FromJelly ;
    mf:name "An objects column with exactly four values of several term types: kinds is one full byte." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#term-types> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:action <triples_rdf_1_1/pos_052/in.jelly> ;
    mf:result <triples_rdf_1_1/pos_052/out.nt> .

<triples_rdf_1_1/pos_053> a jellyt:TestPositive, jellyt:TestRdf12FromJelly ;
    mf:name "The IRI inference state of a column with several term types resets at the start of every batch." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#term-types> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:action <triples_rdf_1_1/pos_053/in.jelly> ;
    mf:result <triples_rdf_1_1/pos_053/out.nt> .

<triples_rdf_1_1/pos_054> a jellyt:TestPositive, jellyt:TestRdf12FromJelly ;
    mf:name "A column with literals and an IRI: the literal kinds and language tags apply to the literals." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#term-types> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:action <triples_rdf_1_1/pos_054/in.jelly> ;
    mf:result <triples_rdf_1_1/pos_054/out.nt> .

<triples_rdf_1_1/pos_055> a jellyt:TestPositive, jellyt:TestRdf12FromJelly ;
    mf:name "prefix_ids with one entry per IRI in a column with several term types: it has one entry per IRI, not per run value, and its inference runs along the IRIs only." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#iris-in-columns> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:action <triples_rdf_1_1/pos_055/in.jelly> ;
    mf:result <triples_rdf_1_1/pos_055/out.nt> .

<triples_rdf_1_1/pos_056> a jellyt:TestPositive, jellyt:TestRdf12FromJelly ;
    mf:name "literal_kinds with one entry per literal in a column with several term types: it has one entry per literal, not per run value." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#literals-in-columns> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:action <triples_rdf_1_1/pos_056/in.jelly> ;
    mf:result <triples_rdf_1_1/pos_056/out.nt> .

<triples_rdf_1_1/pos_057> a jellyt:TestPositive, jellyt:TestRdf12FromJelly ;
    mf:name "Columns whose values are all of one term type need no kinds: an objects column of blank nodes, and one of literals." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#term-types> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:action <triples_rdf_1_1/pos_057/in.jelly> ;
    mf:result <triples_rdf_1_1/pos_057/out.nt> .

<triples_rdf_1_1/pos_058> a jellyt:TestPositive, jellyt:TestRdf12FromJelly ;
    mf:name "kinds set for a column whose values are all of one term type (allowed, producers should leave it empty)." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#term-types> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:action <triples_rdf_1_1/pos_058/in.jelly> ;
    mf:result <triples_rdf_1_1/pos_058/out.nt> .

<triples_rdf_1_1/pos_059> a jellyt:TestPositive, jellyt:TestRdf12FromJelly ;
    mf:name "A subjects column mixing IRIs and blank nodes." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#column-batches> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:action <triples_rdf_1_1/pos_059/in.jelly> ;
    mf:result <triples_rdf_1_1/pos_059/out.nt> .

<triples_rdf_1_1/pos_060> a jellyt:TestPositive, jellyt:TestRdf12FromJelly ;
    mf:name "A column of IRIs only, with no kinds, and a repeat run." ;
    rdfs:comment "kinds may be empty when all run values are of one term type." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#term-types> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:action <triples_rdf_1_1/pos_060/in.jelly> ;
    mf:result <triples_rdf_1_1/pos_060/out.nt> .

<triples_rdf_1_1/pos_061> a jellyt:TestPositive, jellyt:TestRdf12FromJelly ;
    mf:name "Every cell bound, no value repeated in consecutive rows: layouts is empty." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#sequence-layout> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:action <triples_rdf_1_1/pos_061/in.jelly> ;
    mf:result <triples_rdf_1_1/pos_061/out.nt> .

<triples_rdf_1_1/pos_062> a jellyt:TestPositive, jellyt:TestRdf12FromJelly ;
    mf:name "Two repeat runs in a row (skip = 0 between them), then the implicit tail." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#sequence-layout> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:action <triples_rdf_1_1/pos_062/in.jelly> ;
    mf:result <triples_rdf_1_1/pos_062/out.nt> .

<triples_rdf_1_1/pos_063> a jellyt:TestPositive, jellyt:TestRdf12FromJelly ;
    mf:name "Second example of the sequence layout from the specification: A, then B repeated 40 times, then C. layouts = [47, 23]." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#sequence-layout> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:action <triples_rdf_1_1/pos_063/in.jelly> ;
    mf:result <triples_rdf_1_1/pos_063/out.nt> .

<triples_rdf_1_1/pos_064> a jellyt:TestPositive, jellyt:TestRdf12FromJelly ;
    mf:name "The largest repeat run that fits in one token: 16 cells (len_code 14)." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#sequence-layout> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:action <triples_rdf_1_1/pos_064/in.jelly> ;
    mf:result <triples_rdf_1_1/pos_064/out.nt> .

<triples_rdf_1_1/pos_065> a jellyt:TestPositive, jellyt:TestRdf12FromJelly ;
    mf:name "The smallest repeat run that needs an extension varint: 17 cells (len_code 15, extension 0)." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#sequence-layout> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:action <triples_rdf_1_1/pos_065/in.jelly> ;
    mf:result <triples_rdf_1_1/pos_065/out.nt> .

<triples_rdf_1_1/pos_066> a jellyt:TestPositive, jellyt:TestRdf12FromJelly ;
    mf:name "A long repeat run with a multi-byte extension varint: 1000 cells." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#sequence-layout> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:action <triples_rdf_1_1/pos_066/in.jelly> ;
    mf:result <triples_rdf_1_1/pos_066/out.nt> .

<triples_rdf_1_1/pos_067> a jellyt:TestPositive, jellyt:TestRdf12FromJelly ;
    mf:name "Tokens that take more than one byte: skip = 4 and skip = 300." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#sequence-layout> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:action <triples_rdf_1_1/pos_067/in.jelly> ;
    mf:result <triples_rdf_1_1/pos_067/out.nt> .

<triples_rdf_1_1/pos_068> a jellyt:TestPositive, jellyt:TestRdf12FromJelly ;
    mf:name "The subjects and predicates columns as one repeat run each, and an objects column without layouts." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#sequence-layout> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:action <triples_rdf_1_1/pos_068/in.jelly> ;
    mf:result <triples_rdf_1_1/pos_068/out.nt> .

<triples_rdf_1_1/pos_069> a jellyt:TestPositive, jellyt:TestRdf12FromJelly ;
    mf:name "Equal values in consecutive rows stored as separate run values, without a repeat run. All statements must be kept. Consumers must not remove duplicates." ;
    rdfs:comment "Producers should merge equal adjacent run values into one run, so they usually do not write this. The consumer must still decode it." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#sequence-layout> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:action <triples_rdf_1_1/pos_069/in.jelly> ;
    mf:result <triples_rdf_1_1/pos_069/out.nt> .

<triples_rdf_1_1/pos_070> a jellyt:TestPositive, jellyt:TestRdf12FromJelly ;
    mf:name "Two repeat runs of the same value next to each other, not merged into one." ;
    rdfs:comment "Producers should merge adjacent runs, so they usually do not write this. The consumer must still decode it." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#sequence-layout> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:action <triples_rdf_1_1/pos_070/in.jelly> ;
    mf:result <triples_rdf_1_1/pos_070/out.nt> .

<triples_rdf_1_1/pos_071> a jellyt:TestPositive, jellyt:TestRdf12FromJelly ;
    mf:name "Duplicate statements within a frame and across frames are all kept, in order." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#ordering> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:action <triples_rdf_1_1/pos_071/in.jelly> ;
    mf:result <triples_rdf_1_1/pos_071/out.nt> .

<triples_rdf_1_1/pos_072> a jellyt:TestPositive, jellyt:TestRdf12FromJelly ;
    mf:name "Blank node labels are scoped to the whole stream: the same label in different frames and in different columns is the same blank node." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#blank-nodes> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:action <triples_rdf_1_1/pos_072/in.jelly> ;
    mf:result <triples_rdf_1_1/pos_072/out.nt> .

<triples_rdf_1_1/pos_073> a jellyt:TestPositive, jellyt:TestRdf12FromJelly ;
    mf:name "Prefix and datatype lookup identifiers continue across frames: entries with id 0 in the second frame take the next identifiers." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#packed-lookup-entries> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:action <triples_rdf_1_1/pos_073/in.jelly> ;
    mf:result <triples_rdf_1_1/pos_073/out.nt> .

<triples_rdf_1_1/neg_001> a jellyt:TestNegative, jellyt:TestRdf12FromJelly ;
    mf:name "The last frame is truncated: the length prefix is larger than the rest of the file." ;
    rdfs:comment "The length prefix 127 (0x7F) cannot be read as the start of a non-delimited frame: it would be field 15 with the invalid wire type 7." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#delimited-variant-of-jelly> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:action <triples_rdf_1_1/neg_001/in.jelly> .

<triples_rdf_1_1/neg_002> a jellyt:TestNegative, jellyt:TestRdf12FromJelly ;
    mf:name "Version tag 0." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#version-tag> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:notable jellyt:featureShouldLevel ;
    mf:action <triples_rdf_1_1/neg_002/in.jelly> .

<triples_rdf_1_1/neg_003> a jellyt:TestNegative, jellyt:TestRdf12FromJelly ;
    mf:name "Version tag 4, newer than version 3 of the format." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#version-tag> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:notable jellyt:featureShouldLevel ;
    mf:action <triples_rdf_1_1/neg_003/in.jelly> .

<triples_rdf_1_1/neg_004> a jellyt:TestNegative, jellyt:TestRdf12FromJelly ;
    mf:name "generalized_statements set in the stream options. The field is used only in Jelly-RDF 1.0.x and 1.1.x." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#stream-options> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:notable jellyt:featureShouldLevel ;
    mf:action <triples_rdf_1_1/neg_004/in.jelly> .

<triples_rdf_1_1/neg_005> a jellyt:TestNegative, jellyt:TestRdf12FromJelly ;
    mf:name "rdf_star set in the stream options. The field is used only in Jelly-RDF 1.0.x and 1.1.x." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#stream-options> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:notable jellyt:featureShouldLevel ;
    mf:action <triples_rdf_1_1/neg_005/in.jelly> .

<triples_rdf_1_1/neg_006> a jellyt:TestNegative, jellyt:TestRdf12FromJelly ;
    mf:name "logical_type set in the stream options. The field is used only in Jelly-RDF 1.0.x and 1.1.x." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#stream-options> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:notable jellyt:featureShouldLevel ;
    mf:action <triples_rdf_1_1/neg_006/in.jelly> .

<triples_rdf_1_1/neg_007> a jellyt:TestNegative, jellyt:TestRdf12FromJelly ;
    mf:name "physical_type not set (PHYSICAL_STREAM_TYPE_UNSPECIFIED)." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#physical-stream-types> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:action <triples_rdf_1_1/neg_007/in.jelly> .

<triples_rdf_1_1/neg_008> a jellyt:TestNegative, jellyt:TestRdf12FromJelly ;
    mf:name "physical_type GRAPHS, which is used only in Jelly-RDF 1.0.x and 1.1.x." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#physical-stream-types> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:action <triples_rdf_1_1/neg_008/in.jelly> .

<triples_rdf_1_1/neg_009> a jellyt:TestNegative, jellyt:TestRdf12FromJelly ;
    mf:name "Unknown physical_type value 4." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#physical-stream-types> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:action <triples_rdf_1_1/neg_009/in.jelly> .

<triples_rdf_1_1/neg_010> a jellyt:TestNegative, jellyt:TestRdf12FromJelly ;
    mf:name "Unknown stream_type value 2." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#stream-types> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:action <triples_rdf_1_1/neg_010/in.jelly> .

<triples_rdf_1_1/neg_011> a jellyt:TestNegative, jellyt:TestRdf12FromJelly ;
    mf:name "Unknown rdf_version value 4." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#rdf-version> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
