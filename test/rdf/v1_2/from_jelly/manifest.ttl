<messages/neg_002> a jellyt:TestNegative, jellyt:TestRdf12FromJelly ;
    mf:name "message_lengths with a value larger than row_count." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#message-boundaries> ;
