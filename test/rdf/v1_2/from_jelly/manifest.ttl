<messages/pos_001> a jellyt:TestPositive, jellyt:TestRdf12FromJelly ;
    mf:name "Ten messages of three statements each, in one frame." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#message-boundaries> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementMessages ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:action <messages/pos_001/in.jelly> ;
    mf:result (
        <messages/pos_001/out_000.nt>
        <messages/pos_001/out_001.nt>
        <messages/pos_001/out_002.nt>
        <messages/pos_001/out_003.nt>
