        <messages/pos_002/out_002.nt>
    ) .

<messages/pos_003> a jellyt:TestPositive, jellyt:TestRdf12FromJelly ;
    mf:name "Messages with blank nodes, using the same labels in every message." ;
    rdfs:comment "Blank node labels are scoped to one message, so the label x in each message is a different blank node. Messages are compared one at a time, so this test does not check that a consumer keeps them apart." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#blank-nodes> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementMessages ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:action <messages/pos_003/in.jelly> ;
    mf:result (
        <messages/pos_003/out_000.nt>
        <messages/pos_003/out_001.nt>
        <messages/pos_003/out_002.nt>
        <messages/pos_003/out_003.nt>
    ) .

<messages/pos_004> a jellyt:TestPositive, jellyt:TestRdf12FromJelly ;
    mf:name "Messages that are RDF datasets: quads in the default graph and in named graphs." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#stream-types> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementMessages ;
    mf:requires jellyt:requirementPhysicalTypeQuads ;
    mf:action <messages/pos_004/in.jelly> ;
    mf:result (
        <messages/pos_004/out_000.nq>
        <messages/pos_004/out_001.nq>
        <messages/pos_004/out_002.nq>
    ) .

<messages/pos_005> a jellyt:TestPositive, jellyt:TestRdf12FromJelly ;
    mf:name "Example from the specification: a statement left over from the previous frame, and message_lengths [2, 0, 1] in a batch of 5 statements." ;
    rdfs:comment "The first message is 0, 1, 2. The value 0 then ends an empty message. The value 1 adds statement 3 and ends that message. Statements 4 and 5 start the next message, and the last frame adds 6 and ends it." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#message-boundaries> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementMessages ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:action <messages/pos_005/in.jelly> ;
    mf:result (
        <messages/pos_005/out_000.nt>
        <messages/pos_005/out_001.nt>
        <messages/pos_005/out_002.nt>
        <messages/pos_005/out_003.nt>
    ) .

<messages/pos_006> a jellyt:TestPositive, jellyt:TestRdf12FromJelly ;
    mf:name "One message per frame: message_lengths is [row_count] in every frame." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#message-boundaries> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementMessages ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:action <messages/pos_006/in.jelly> ;
    mf:result (
        <messages/pos_006/out_000.nt>
        <messages/pos_006/out_001.nt>
    ) .

<messages/pos_007> a jellyt:TestPositive, jellyt:TestRdf12FromJelly ;
    mf:name "Empty messages: a value of 0 at the start of a batch and two in a row." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#message-boundaries> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementMessages ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:action <messages/pos_007/in.jelly> ;
    mf:result (
        <messages/pos_007/out_000.nt>
        <messages/pos_007/out_001.nt>
        <messages/pos_007/out_002.nt>
        <messages/pos_007/out_003.nt>
    ) .

<messages/pos_008> a jellyt:TestPositive, jellyt:TestRdf12FromJelly ;
    mf:name "A batch with row_count 0 and message_lengths [0]: an empty message." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#message-boundaries> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementMessages ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:action <messages/pos_008/in.jelly> ;
    mf:result (
        <messages/pos_008/out_000.nt>
        <messages/pos_008/out_001.nt>
        <messages/pos_008/out_002.nt>
    ) .

<messages/pos_009> a jellyt:TestPositive, jellyt:TestRdf12FromJelly ;
    mf:name "A batch with row_count 0 and message_lengths [0] ends a message started in the previous frame." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#message-boundaries> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementMessages ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:action <messages/pos_009/in.jelly> ;
    mf:result (
        <messages/pos_009/out_000.nt>
        <messages/pos_009/out_001.nt>
    ) .

<messages/pos_010> a jellyt:TestPositive, jellyt:TestRdf12FromJelly ;
    mf:name "The last message has no boundary: it ends at the end of the stream." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#message-boundaries> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementMessages ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:action <messages/pos_010/in.jelly> ;
    mf:result (
        <messages/pos_010/out_000.nt>
        <messages/pos_010/out_001.nt>
    ) .

<messages/pos_011> a jellyt:TestPositive, jellyt:TestRdf12FromJelly ;
    mf:name "The stream ends right after a boundary: no further message is added." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#message-boundaries> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementMessages ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:action <messages/pos_011/in.jelly> ;
    mf:result (
        <messages/pos_011/out_000.nt>
    ) .

<messages/pos_012> a jellyt:TestPositive, jellyt:TestRdf12FromJelly ;
    mf:name "Restated stream options end the current message." ;
    rdfs:comment "The statement b has no boundary after it, but the restated options end its message." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#restating-the-stream-options> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementMessages ;
    mf:requires jellyt:requirementPhysicalTypeTriples ;
    mf:action <messages/pos_012/in.jelly> ;
    mf:result (
        <messages/pos_012/out_000.nt>
        <messages/pos_012/out_001.nt>
        <messages/pos_012/out_002.nt>
    ) .

<messages/pos_013> a jellyt:TestPositive, jellyt:TestRdf12FromJelly ;
    mf:name "Restated stream options right after a boundary: no empty message is added." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/serialization/#restating-the-stream-options> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementMessages ;
