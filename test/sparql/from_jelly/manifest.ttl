    rdft:approval rdft:Proposed ;
    mf:notable jellyt:featureShouldLevel ;
    mf:action <ask/neg_001/in.jellys> .

<ask/neg_002> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "A boolean result frame that contains a column." ;
