<select_rdf_1_1/neg_015> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "A prefix lookup entry with an identifier larger than the table size." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#stream-options> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/neg_015/in.jellys> .

<select_rdf_1_1/neg_016> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "An IRI column refers to a prefix identifier outside the prefix table." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#iri-columns> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/neg_016/in.jellys> .

<select_rdf_1_1/neg_017> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "An IRI column refers to a name that was never defined (name_id 0 at the start of a column means 1, and the name table is empty)." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#iri-columns> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/neg_017/in.jellys> .

<select_rdf_1_1/neg_018> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "An IRI column refers to a name identifier outside the name table." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#iri-columns> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/neg_018/in.jellys> .

<select_rdf_1_1/neg_019> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "An IRI column uses prefix_ids while the prefix lookup is disabled." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#stream-options> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/neg_019/in.jellys> .

<select_rdf_1_1/neg_020> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "prefix_ids with 2 entries for 3 values. The length must be 0, 1, or the number of values." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#iri-columns> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/neg_020/in.jellys> .

<select_rdf_1_1/neg_021> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "A literal column refers to a datatype identifier outside the datatype table." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#literal-columns> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/neg_021/in.jellys> .

<select_rdf_1_1/neg_022> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "A literal column refers to a datatype while the datatype lookup is disabled." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#stream-options> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/neg_022/in.jellys> .

<select_rdf_1_1/neg_023> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "A literal in the full form with datatype 0, which is invalid (unlike in the lexical form)." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#literal-columns> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/neg_023/in.jellys> .

<select_rdf_1_1/neg_024> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "A literal column in the lexical form whose datatype is rdf:langString." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#literal-columns> ;
    rdft:approval rdft:Proposed ;
    mf:notable jellyt:featureShouldLevel ;
    mf:action <select_rdf_1_1/neg_024/in.jellys> .

<select_rdf_1_1/neg_025> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "A literal in the full form whose datatype is rdf:langString." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#base-direction> ;
    rdft:approval rdft:Proposed ;
    mf:notable jellyt:featureShouldLevel ;
    mf:action <select_rdf_1_1/neg_025/in.jellys> .

<select_rdf_1_1/neg_026> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "A literal column with both values and lex_values set." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#literal-columns> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/neg_026/in.jellys> .

<select_rdf_1_1/neg_027> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "A literal column in the full form (lex_values empty) that sets datatype." ;
