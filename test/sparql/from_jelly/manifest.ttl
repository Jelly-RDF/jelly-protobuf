    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#stream-trailer> ;
    rdft:approval rdft:Proposed ;
    mf:action <ask/neg_006/in.jellys> .

<select_rdf_1_2_basic/pos_001> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "A column of directional language-tagged strings (ltr and rtl) and a language-tagged string without a direction. The tag en is listed twice in langtags, with different directions." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#base-direction> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementRdf12Basic ;
