<select_rdf_1_1/pos_031> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "name_ids mixing explicit identifiers and 0 (previous + 1): [5, 0, 0, 2, 0] is 5, 6, 7, 2, 3." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#iri-columns> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_031/in.jellys> ;
    mf:result <select_rdf_1_1/pos_031/out.srj> .

<select_rdf_1_1/pos_032> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "The name_id and prefix_id inference state resets at the start of every column." ;
    rdfs:comment "The first column ends at name 3 with prefix 2. The second column still starts from name 0 and no prefix: its first name_id of 0 means name 1, and its first prefix_id of 0 means no prefix, not the prefix of the previous column." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#iri-columns> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_032/in.jellys> ;
    mf:result <select_rdf_1_1/pos_032/out.srj> .

<select_rdf_1_1/pos_033> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "The name_id inference state resets at the start of every frame." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#iri-columns> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_033/in.jellys> ;
    mf:result <select_rdf_1_1/pos_033/out.srj> .

<select_rdf_1_1/pos_034> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "An empty name: the IRI is equal to its prefix." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#iri-columns> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_034/in.jellys> ;
    mf:result <select_rdf_1_1/pos_034/out.srj> .

<select_rdf_1_1/pos_035> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "Lookup identifiers continue across frames: an entry with id 0 in the second frame takes the next identifier." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#packed-lookup-entries> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_035/in.jellys> ;
    mf:result <select_rdf_1_1/pos_035/out.srj> .

<select_rdf_1_1/pos_036> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "Packed entries with explicit identifiers: id 10 with two values, then id 0 continuing at 12." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#packed-lookup-entries> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_036/in.jellys> ;
    mf:result <select_rdf_1_1/pos_036/out.srj> .

<select_rdf_1_1/pos_037> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "An entry overwritten in a later frame: the later frame sees the new value." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#prefix-name-and-datatype-lookup-entries> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_037/in.jellys> ;
    mf:result <select_rdf_1_1/pos_037/out.srj> .

<select_rdf_1_1/pos_038> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "All lookup entries of a frame are applied before its columns: a name overwritten twice in one frame decodes to the last value." ;
    rdfs:comment "A producer must not write such a frame if it means the first value (the working set rule), but a consumer has to decode it this way." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#the-working-set-of-a-frame> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_038/in.jellys> ;
    mf:result <select_rdf_1_1/pos_038/out.srj> .

<select_rdf_1_1/pos_039> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "A name lookup entry at the largest identifier the table allows." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#stream-options> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_039/in.jellys> ;
    mf:result <select_rdf_1_1/pos_039/out.srj> .

<select_rdf_1_1/pos_040> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "Lookup table sizes at the recommended default consumer limits: 16384 names, 4096 prefixes, 256 datatypes." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#stream-options> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_040/in.jellys> ;
    mf:result <select_rdf_1_1/pos_040/out.srj> .

<select_rdf_1_1/pos_041> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "Column order is not projection order: the variables are returned in header order, whatever their column indices." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#column-indices> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_041/in.jellys> ;
    mf:result <select_rdf_1_1/pos_041/out.srj> .

<select_rdf_1_1/pos_042> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "All four column types in one frame. Column indices follow the virtual concatenation iri, bnode, literal, poly." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#column-indices> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_042/in.jellys> ;
    mf:result <select_rdf_1_1/pos_042/out.srj> .

<select_rdf_1_1/pos_043> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "Variables unbound in every row, each encoded as an empty column message of a different type." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#columns> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_043/in.jellys> ;
    mf:result <select_rdf_1_1/pos_043/out.srj> .

<select_rdf_1_1/pos_044> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "Header restated to move a variable from an IRI column to a polymorphic column. A later frame without a header keeps the restated layout." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#restating-the-header> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_044/in.jellys> ;
    mf:result <select_rdf_1_1/pos_044/out.srj> .

<select_rdf_1_1/pos_045> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "Header restated with only the column indices changed (the columns of the same type swap places)." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#restating-the-header> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_045/in.jellys> ;
    mf:result <select_rdf_1_1/pos_045/out.srj> .

<select_rdf_1_1/pos_046> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "Header restated identically to the one in effect (allowed, producers should not do it)." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#restating-the-header> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_046/in.jellys> ;
    mf:result <select_rdf_1_1/pos_046/out.srj> .

<select_rdf_1_1/pos_047> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "A variable with an empty name (allowed, not recommended)." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#result-set-header> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_047/in.jellys> ;
    mf:result <select_rdf_1_1/pos_047/out.srj> .

<select_rdf_1_1/pos_048> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "A frame with no rows and no columns in the middle of a stream, carrying only lookup entries for the next frame." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#frames-with-no-rows> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_048/in.jellys> ;
    mf:result <select_rdf_1_1/pos_048/out.srj> .

<select_rdf_1_1/pos_049> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "A frame with no rows that carries one empty column per variable (allowed, producers should omit the columns)." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#frames-with-no-rows> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_049/in.jellys> ;
    mf:result <select_rdf_1_1/pos_049/out.srj> .

<select_rdf_1_1/pos_050> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "An empty result set whose first frame carries one empty column per variable." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#frames-with-no-rows> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_050/in.jellys> ;
    mf:result <select_rdf_1_1/pos_050/out.srj> .

<select_rdf_1_1/pos_051> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "A zero-variable result set with one empty solution (e.g., SELECT * WHERE {})." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#zero-variable-result-sets> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_051/in.jellys> ;
    mf:result <select_rdf_1_1/pos_051/out.srj> .

<select_rdf_1_1/pos_052> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "A zero-variable result set with three empty solutions over two frames." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#zero-variable-result-sets> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_052/in.jellys> ;
    mf:result <select_rdf_1_1/pos_052/out.srj> .

<select_rdf_1_1/pos_053> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "A zero-variable result set with no solutions." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#zero-variable-result-sets> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_053/in.jellys> ;
    mf:result <select_rdf_1_1/pos_053/out.srj> .

<select_rdf_1_1/pos_054> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "Two zero-variable streams concatenated: the repeated options come with an empty header, which declares zero variables again." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#repeating-the-stream-options> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_054/in.jellys> ;
    mf:result <select_rdf_1_1/pos_054/out.srj> .

<select_rdf_1_1/pos_055> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "Literal column, lexical form, simple literals (datatype 0)." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#literal-columns> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_055/in.jellys> ;
    mf:result <select_rdf_1_1/pos_055/out.srj> .

<select_rdf_1_1/pos_056> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "xsd:string literals encoded three ways: lexical form with datatype 0, lexical form with an xsd:string datatype entry, and full form with an xsd:string datatype entry. All are the same simple literal." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#literal-columns> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_056/in.jellys> ;
    mf:result <select_rdf_1_1/pos_056/out.srj> .

<select_rdf_1_1/pos_057> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "Literal column, lexical form, typed literals (xsd:integer, then xsd:dateTime)." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#literal-columns> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_057/in.jellys> ;
    mf:result <select_rdf_1_1/pos_057/out.srj> .

<select_rdf_1_1/pos_058> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "Literal column, lexical form, one language tag for the whole column." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#literal-columns> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_058/in.jellys> ;
    mf:result <select_rdf_1_1/pos_058/out.srj> .

<select_rdf_1_1/pos_059> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "Literal column, full form, mixing simple, typed, and language-tagged literals with different tags." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#literal-columns> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_059/in.jellys> ;
    mf:result <select_rdf_1_1/pos_059/out.srj> .

<select_rdf_1_1/pos_060> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "Empty lexical forms, in the lexical form and in the full form." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#literal-columns> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_060/in.jellys> ;
    mf:result <select_rdf_1_1/pos_060/out.srj> .

<select_rdf_1_1/pos_061> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "Polymorphic column: the IRI inference state is shared by the IRIs of the column and skips other values." ;
    rdfs:comment "Values: iri(prefix 1, name 0 -> 1), bnode, literal, iri(0, 0 -> 2), iri(0, 5), iri(0, 0 -> 6)." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#polymorphic-columns> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_061/in.jellys> ;
    mf:result <select_rdf_1_1/pos_061/out.srj> .

<select_rdf_1_1/pos_062> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "Polymorphic column: the IRI inference state resets at the start of every frame." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#polymorphic-columns> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_062/in.jellys> ;
    mf:result <select_rdf_1_1/pos_062/out.srj> .

<select_rdf_1_1/pos_063> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "Blank node labels are scoped to the whole stream: the same label in different frames and in different column types is the same blank node." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#blank-node-columns> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_063/in.jellys> ;
    mf:result <select_rdf_1_1/pos_063/out.srj> .

<select_rdf_1_1/pos_064> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "The well-known link metadata key with two IRIs, mapped to head.link." ;
    rdfs:comment "The equivalence of result sets does not cover links. Implementations that expose links should check them against head.link." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#well-known-metadata-keys> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_064/in.jellys> ;
    mf:result <select_rdf_1_1/pos_064/out.srj> .

<select_rdf_1_1/pos_065> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "Metadata with an implementation-defined key whose value is not valid UTF-8. It must be ignored." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#frame-metadata> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_065/in.jellys> ;
    mf:result <select_rdf_1_1/pos_065/out.srj> .

<select_rdf_1_1/pos_066> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "The link metadata key with a value that is not valid UTF-8. Consumers should ignore it." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#well-known-metadata-keys> ;
    rdft:approval rdft:Proposed ;
    mf:notable jellyt:featureShouldLevel ;
    mf:action <select_rdf_1_1/pos_066/in.jellys> ;
    mf:result <select_rdf_1_1/pos_066/out.srj> .

<select_rdf_1_1/pos_067> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "Stream options with a stream name." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#stream-options> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_067/in.jellys> ;
    mf:result <select_rdf_1_1/pos_067/out.srj> .

<select_rdf_1_1/pos_068> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "A trailer-only final frame (row_count 0, no columns, only the trailer)." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#stream-trailer> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_068/in.jellys> ;
    mf:result <select_rdf_1_1/pos_068/out.srj> .

<select_rdf_1_1/pos_069> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "A stream without a trailer. The result set is valid; consumers should report that it may be truncated." ;
    rdfs:comment "Consumers may warn or report the missing trailer, but must not fail this test." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#stream-trailer> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_069/in.jellys> ;
    mf:result <select_rdf_1_1/pos_069/out.srj> .

<select_rdf_1_1/pos_070> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "Two streams of the same query concatenated. The second segment repeats the options (with other table sizes) and the header, and its lookup identifiers restart from 1." ;
    rdfs:comment "Blank node labels are not reset by the repeated options: the label x in both segments is one blank node." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#repeating-the-stream-options> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_070/in.jellys> ;
    mf:result <select_rdf_1_1/pos_070/out.srj> .

<select_rdf_1_1/pos_071> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "Concatenated streams with different column layouts: the restated header maps the same variables to other column types." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#repeating-the-stream-options> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_071/in.jellys> ;
    mf:result <select_rdf_1_1/pos_071/out.srj> .

<select_rdf_1_1/pos_072> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "Options repeated without a trailer before them (a producer that did not write trailers)." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#repeating-the-stream-options> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_072/in.jellys> ;
    mf:result <select_rdf_1_1/pos_072/out.srj> .

<select_rdf_1_1/neg_001> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "An empty file: a result stream must contain at least one frame." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#result-frames> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/neg_001/in.jellys> .

<select_rdf_1_1/neg_002> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "The last frame is truncated: the length prefix promises more bytes than the file has." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#framing> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/neg_002/in.jellys> .

<select_rdf_1_1/neg_003> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "Version tag 0." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#stream-options> ;
    rdft:approval rdft:Proposed ;
    mf:notable jellyt:featureShouldLevel ;
    mf:action <select_rdf_1_1/neg_003/in.jellys> .

<select_rdf_1_1/neg_004> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "Version tag 2, newer than version 1 of the format." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#stream-options> ;
    rdft:approval rdft:Proposed ;
    mf:notable jellyt:featureShouldLevel ;
    mf:action <select_rdf_1_1/neg_004/in.jellys> .

<select_rdf_1_1/neg_005> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "max_name_table_size 127, below the minimum of 128." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#stream-options> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/neg_005/in.jellys> .

<select_rdf_1_1/neg_006> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "max_name_table_size not set (0)." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#stream-options> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/neg_006/in.jellys> .

<select_rdf_1_1/neg_007> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "max_name_table_size 10000000. Consumers must limit the lookup sizes they accept (recommended default 16384)." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#overly-large-lookup-tables> ;
    rdft:approval rdft:Proposed ;
    mf:notable jellyt:featureShouldLevel ;
    mf:action <select_rdf_1_1/neg_007/in.jellys> .

<select_rdf_1_1/neg_008> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "max_prefix_table_size 10000000. Consumers must limit the lookup sizes they accept (recommended default 4096)." ;
