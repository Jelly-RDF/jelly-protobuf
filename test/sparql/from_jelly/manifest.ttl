<select_rdf_1_2_basic/pos_004> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "A directional literal in a column with several term types." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#base-direction> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementRdf12Basic ;
    mf:action <select_rdf_1_2_basic/pos_004/in.jellys> ;
    mf:result <select_rdf_1_2_basic/pos_004/out.srj> .

<select_rdf_1_2_basic/pos_005> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "Common usage: labels in several languages and directions, over several frames." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#base-direction> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementRdf12Basic ;
    mf:action <select_rdf_1_2_basic/pos_005/in.jellys> ;
