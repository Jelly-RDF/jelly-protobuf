<select_rdf_1_2_basic/pos_002> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "Lexical-form literal column with a shared language tag and base direction." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#literal-columns> ;
