<select_rdf_1_2/pos_001> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "A triple term of three IRIs." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#triple-terms> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementRdf12 ;
    mf:action <select_rdf_1_2/pos_001/in.jellys> ;
    mf:result <select_rdf_1_2/pos_001/out.srj> .

<select_rdf_1_2/pos_002> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "A triple term with a blank node subject and a directional literal object." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#triple-terms> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementRdf12 ;
    mf:action <select_rdf_1_2/pos_002/in.jellys> ;
    mf:result <select_rdf_1_2/pos_002/out.srj> .

<select_rdf_1_2/pos_003> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "Triple terms nested three levels deep (in the object position)." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#triple-terms> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementRdf12 ;
    mf:action <select_rdf_1_2/pos_003/in.jellys> ;
    mf:result <select_rdf_1_2/pos_003/out.srj> .

<select_rdf_1_2/pos_004> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "The IRIs inside the triple terms of a column have their own IRI inference state, separate from the other IRIs of the column." ;
    rdfs:comment "All name_ids are 0. The IRIs of the column (name_ids) give names 1 and 2. The triple term starts from name 0 again: its subject, predicate, and object are names 1, 2, and 3." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#triple-terms> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementRdf12 ;
    mf:action <select_rdf_1_2/pos_004/in.jellys> ;
    mf:result <select_rdf_1_2/pos_004/out.srj> .

<select_rdf_1_2/pos_005> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "The IRI inference state of the triple terms runs through all triple terms of the column, in subject, predicate, object order." ;
    rdfs:comment "All name_ids are 0: the second triple term continues from name 3, and keeps the prefix of the first." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#triple-terms> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementRdf12 ;
    mf:action <select_rdf_1_2/pos_005/in.jellys> ;
    mf:result <select_rdf_1_2/pos_005/out.srj> .

<select_rdf_1_2/pos_006> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "The IRI inference state of the triple terms resets at the start of every column and every frame." ;
    rdfs:comment "All name_ids are 0. Without the reset, the second column and the second frame would go on from name 4 (d, e, f)." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#triple-terms> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementRdf12 ;
    mf:action <select_rdf_1_2/pos_006/in.jellys> ;
    mf:result <select_rdf_1_2/pos_006/out.srj> .

<select_rdf_1_2/pos_007> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "The name_id inference of the triple terms goes on into a nested triple term." ;
    rdfs:comment "All name_ids are 0: subject and predicate of the outer triple term are names 1 and 2, then the nested triple term gives names 3, 4, and 5." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#triple-terms> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementRdf12 ;
    mf:action <select_rdf_1_2/pos_007/in.jellys> ;
    mf:result <select_rdf_1_2/pos_007/out.srj> .

<select_rdf_1_2/pos_008> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "A triple term with a blank node object." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#triple-terms> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementRdf12 ;
    mf:action <select_rdf_1_2/pos_008/in.jellys> ;
    mf:result <select_rdf_1_2/pos_008/out.srj> .

<select_rdf_1_2/pos_009> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "A prefix_id of 0 in the first IRI of the triple terms of a column means no prefix, even after the other IRIs of the column used a prefix." ;
    rdfs:comment "The IRIs of the column use prefix 1. The triple terms have their own state, so the subject, with prefix_id 0, has no prefix: its name holds the whole IRI." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#triple-terms> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementRdf12 ;
    mf:action <select_rdf_1_2/pos_009/in.jellys> ;
    mf:result <select_rdf_1_2/pos_009/out.srj> .

<select_rdf_1_2/pos_010> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "A blank node inside a triple term and the same label in another column are the same blank node." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#triple-terms> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementRdf12 ;
    mf:action <select_rdf_1_2/pos_010/in.jellys> ;
    mf:result <select_rdf_1_2/pos_010/out.srj> .

<select_rdf_1_2/pos_011> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "A triple term in a stream that declares no RDF version (allowed: no version is announced)." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#rdf-version> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementRdf12 ;
    mf:action <select_rdf_1_2/pos_011/in.jellys> ;
    mf:result <select_rdf_1_2/pos_011/out.srj> .

<select_rdf_1_2/pos_012> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "The same triple term in consecutive rows, as a repeat run." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#triple-terms> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementRdf12 ;
    mf:action <select_rdf_1_2/pos_012/in.jellys> ;
    mf:result <select_rdf_1_2/pos_012/out.srj> .

<select_rdf_1_2/pos_013> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "Concatenated streams: the first segment declares RDF 1.1, the second declares RDF 1.2 and has a triple term." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#rdf-version> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementRdf12 ;
    mf:action <select_rdf_1_2/pos_013/in.jellys> ;
    mf:result <select_rdf_1_2/pos_013/out.srj> .

<select_rdf_1_2/pos_014> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "Directional literals in a stream that declares RDF 1.2 (which includes RDF 1.2 Basic)." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#rdf-version> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementRdf12 ;
    mf:action <select_rdf_1_2/pos_014/in.jellys> ;
    mf:result <select_rdf_1_2/pos_014/out.srj> .

<select_rdf_1_2/pos_015> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "Common usage: an annotation query returning statements as triple terms, with IRIs, literals, and nested triple terms, over several frames." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#triple-terms> ;
