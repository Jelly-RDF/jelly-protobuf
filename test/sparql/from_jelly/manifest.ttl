<select_rdf_1_1/pos_028> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "prefix_ids with a single entry: every value uses that prefix." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#iris> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_028/in.jellys> ;
    mf:result <select_rdf_1_1/pos_028/out.srj> .

<select_rdf_1_1/pos_029> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "Empty prefix_ids with the prefix lookup enabled: no value has a prefix, the names hold whole IRIs." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#iris> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_029/in.jellys> ;
    mf:result <select_rdf_1_1/pos_029/out.srj> .

<select_rdf_1_1/pos_030> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "prefix_ids with one entry per value, starting with 0: the prefix inference state starts from \"no prefix\"." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#iris> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_030/in.jellys> ;
    mf:result <select_rdf_1_1/pos_030/out.srj> .

<select_rdf_1_1/pos_031> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "name_ids mixing explicit identifiers and 0 (previous + 1): [5, 0, 0, 2, 0] is 5, 6, 7, 2, 3." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#iris> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_031/in.jellys> ;
    mf:result <select_rdf_1_1/pos_031/out.srj> .

<select_rdf_1_1/pos_032> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "The name_id and prefix_id inference state resets at the start of every column." ;
    rdfs:comment "The first column ends at name 3 with prefix 2. The second column still starts from name 0 and no prefix: its first name_id of 0 means name 1, and its first prefix_id of 0 means no prefix, not the prefix of the previous column." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#iris> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_032/in.jellys> ;
    mf:result <select_rdf_1_1/pos_032/out.srj> .

<select_rdf_1_1/pos_033> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "The name_id inference state resets at the start of every frame." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#iris> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_033/in.jellys> ;
    mf:result <select_rdf_1_1/pos_033/out.srj> .

<select_rdf_1_1/pos_034> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "An empty name: the IRI is equal to its prefix." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#iris> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_034/in.jellys> ;
    mf:result <select_rdf_1_1/pos_034/out.srj> .

<select_rdf_1_1/pos_035> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "Lookup identifiers continue across frames: an entry with id 0 in the second frame takes the next identifier." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#packed-lookup-entries> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_035/in.jellys> ;
    mf:result <select_rdf_1_1/pos_035/out.srj> .

<select_rdf_1_1/pos_036> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "Packed entries with explicit identifiers: id 10 with two values, then id 0 continuing at 12." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#packed-lookup-entries> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_036/in.jellys> ;
    mf:result <select_rdf_1_1/pos_036/out.srj> .

<select_rdf_1_1/pos_037> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "An entry overwritten in a later frame: the later frame sees the new value." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#prefix-name-and-datatype-lookup-entries> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_037/in.jellys> ;
    mf:result <select_rdf_1_1/pos_037/out.srj> .

<select_rdf_1_1/pos_038> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "All lookup entries of a frame are applied before its columns: a name overwritten twice in one frame decodes to the last value." ;
    rdfs:comment "A producer must not write such a frame if it means the first value (the working set rule), but a consumer has to decode it this way." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#the-working-set-of-a-frame> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_038/in.jellys> ;
    mf:result <select_rdf_1_1/pos_038/out.srj> .

<select_rdf_1_1/pos_039> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "A name lookup entry at the largest identifier the table allows." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#stream-options> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_039/in.jellys> ;
    mf:result <select_rdf_1_1/pos_039/out.srj> .

<select_rdf_1_1/pos_040> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "Lookup table sizes at the recommended default consumer limits: 16384 names, 4096 prefixes, 256 datatypes." ;
    rdfs:comment "Consumers may set lower limits than the recommended defaults, and then reject this stream." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#stream-options> ;
    rdft:approval rdft:Proposed ;
    mf:notable jellyt:featureShouldLevel ;
    mf:action <select_rdf_1_1/pos_040/in.jellys> ;
    mf:result <select_rdf_1_1/pos_040/out.srj> .

<select_rdf_1_1/pos_041> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "The columns are in the order of the variables, whatever the term types of their values." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#result-set-header> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_041/in.jellys> ;
    mf:result <select_rdf_1_1/pos_041/out.srj> .

<select_rdf_1_1/pos_042> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "Columns with values of different term types in one frame: blank nodes and literals mixed, literals, blank nodes, and IRIs." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#columns> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_042/in.jellys> ;
    mf:result <select_rdf_1_1/pos_042/out.srj> .

<select_rdf_1_1/pos_043> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "Variables unbound in every row, each encoded as an empty column message, next to a variable bound in every row." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#columns> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_043/in.jellys> ;
    mf:result <select_rdf_1_1/pos_043/out.srj> .

<select_rdf_1_1/pos_044> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "A variable whose term types change from frame to frame: IRIs only (no kinds), then a literal, then an IRI and a literal (with kinds)." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#term-types> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_044/in.jellys> ;
    mf:result <select_rdf_1_1/pos_044/out.srj> .

<select_rdf_1_1/pos_045> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "Columns whose values are all of one term type need no kinds: a column of blank nodes and a column of literals." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#term-types> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_045/in.jellys> ;
    mf:result <select_rdf_1_1/pos_045/out.srj> .

<select_rdf_1_1/pos_046> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "kinds set for a column whose values are all of one term type (allowed, producers should leave it empty)." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#term-types> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_046/in.jellys> ;
    mf:result <select_rdf_1_1/pos_046/out.srj> .

<select_rdf_1_1/pos_047> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "A frame with no rows and no columns in the middle of a stream, with only lookup entries for the next frame." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#columns> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_047/in.jellys> ;
    mf:result <select_rdf_1_1/pos_047/out.srj> .

<select_rdf_1_1/pos_048> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "A frame with no rows and one empty column per variable." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#columns> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_048/in.jellys> ;
    mf:result <select_rdf_1_1/pos_048/out.srj> .

<select_rdf_1_1/pos_049> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "An empty result set whose first frame has one empty column per variable." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#columns> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_049/in.jellys> ;
    mf:result <select_rdf_1_1/pos_049/out.srj> .

<select_rdf_1_1/pos_050> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "A zero-variable result set with one empty solution (e.g., SELECT * WHERE {})." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#zero-variable-result-sets> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_050/in.jellys> ;
    mf:result <select_rdf_1_1/pos_050/out.srj> .

<select_rdf_1_1/pos_051> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "A zero-variable result set with three empty solutions over two frames." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#zero-variable-result-sets> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_051/in.jellys> ;
    mf:result <select_rdf_1_1/pos_051/out.srj> .

<select_rdf_1_1/pos_052> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "A zero-variable result set with no solutions." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#zero-variable-result-sets> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_052/in.jellys> ;
    mf:result <select_rdf_1_1/pos_052/out.srj> .

<select_rdf_1_1/pos_053> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "Two zero-variable streams concatenated: the repeated options come with an empty header, which declares zero variables again." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#repeating-the-stream-options> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_053/in.jellys> ;
    mf:result <select_rdf_1_1/pos_053/out.srj> .

<select_rdf_1_1/pos_054> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "A column of simple literals: literal_kinds is empty." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#literals> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_054/in.jellys> ;
    mf:result <select_rdf_1_1/pos_054/out.srj> .

<select_rdf_1_1/pos_055> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "xsd:string literals encoded three ways: no literal kinds, a single literal kind referring to an xsd:string datatype entry, and one literal kind per value mixing 0 and that entry. All are the same simple literal." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#literals> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_055/in.jellys> ;
    mf:result <select_rdf_1_1/pos_055/out.srj> .

<select_rdf_1_1/pos_056> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "A column of literals with a single literal kind for the whole column: xsd:integer, then xsd:dateTime." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#literals> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_056/in.jellys> ;
    mf:result <select_rdf_1_1/pos_056/out.srj> .

<select_rdf_1_1/pos_057> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "A column of literals with one language tag for the whole column: a single literal kind of 2." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#literals> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_057/in.jellys> ;
    mf:result <select_rdf_1_1/pos_057/out.srj> .

<select_rdf_1_1/pos_058> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "A column of literals with one literal kind per value, mixing simple, typed, and language-tagged literals with different tags." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#literals> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_058/in.jellys> ;
    mf:result <select_rdf_1_1/pos_058/out.srj> .

<select_rdf_1_1/pos_059> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "Literal kind values: 0 is a simple literal, odd values 1, 3, 5 are datatypes 1, 2, 3, and even values 2, 4, 6 are language tags 0, 1, 2." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#literals> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_059/in.jellys> ;
    mf:result <select_rdf_1_1/pos_059/out.srj> .

<select_rdf_1_1/pos_060> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "Empty lexical forms, with a single literal kind and with one literal kind per value." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#literals> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_060/in.jellys> ;
    mf:result <select_rdf_1_1/pos_060/out.srj> .

<select_rdf_1_1/pos_061> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "langtag_directions with only 0 entries (no base direction) in a stream that declares RDF 1.1." ;
    rdfs:comment "Producers should leave langtag_directions empty instead, but a list of zeros is valid." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#literals> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_061/in.jellys> ;
    mf:result <select_rdf_1_1/pos_061/out.srj> .

<select_rdf_1_1/pos_062> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "A column with values of several term types: kinds says which list holds each run value. Six values need two bytes of kinds." ;
    rdfs:comment "kinds = [0x18, 0x00]: IRI, blank node, literal, IRI in the first byte, then IRI, IRI. The IRIs are decoded from name_ids [0, 0, 5, 0]: names 1, 2, 5, 6." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#term-types> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_062/in.jellys> ;
    mf:result <select_rdf_1_1/pos_062/out.srj> .

<select_rdf_1_1/pos_063> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "A column with exactly four values of several term types: kinds is one full byte." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#term-types> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_063/in.jellys> ;
    mf:result <select_rdf_1_1/pos_063/out.srj> .

<select_rdf_1_1/pos_064> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "The IRI inference state of a column with several term types resets at the start of every frame." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#term-types> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_064/in.jellys> ;
    mf:result <select_rdf_1_1/pos_064/out.srj> .

<select_rdf_1_1/pos_065> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "A column with literals and an IRI: the literal kinds and language tags apply to the literals." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#term-types> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_065/in.jellys> ;
    mf:result <select_rdf_1_1/pos_065/out.srj> .

<select_rdf_1_1/pos_066> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "prefix_ids with one entry per IRI in a column with several term types: it has one entry per IRI, not per run value, and its inference runs along the IRIs only." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#iris> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_066/in.jellys> ;
    mf:result <select_rdf_1_1/pos_066/out.srj> .

<select_rdf_1_1/pos_067> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "literal_kinds with one entry per literal in a column with several term types: it has one entry per literal, not per run value." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#literals> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_067/in.jellys> ;
    mf:result <select_rdf_1_1/pos_067/out.srj> .

<select_rdf_1_1/pos_068> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "Blank node labels are scoped to the whole stream: the same label in different frames and in different columns is the same blank node." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#blank-nodes> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_068/in.jellys> ;
    mf:result <select_rdf_1_1/pos_068/out.srj> .

<select_rdf_1_1/pos_069> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "The well-known link metadata key with two IRIs, mapped to head.link." ;
    rdfs:comment "The equivalence of result sets does not cover links. Implementations that expose links should check them against head.link." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#well-known-metadata-keys> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_069/in.jellys> ;
    mf:result <select_rdf_1_1/pos_069/out.srj> .

<select_rdf_1_1/pos_070> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "Metadata with an implementation-defined key whose value is not valid UTF-8. Consumers must not fail on it, and should ignore it." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#frame-metadata> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_070/in.jellys> ;
    mf:result <select_rdf_1_1/pos_070/out.srj> .

<select_rdf_1_1/pos_071> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "The link metadata key with a value that is not valid UTF-8. Consumers should ignore it." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#well-known-metadata-keys> ;
    rdft:approval rdft:Proposed ;
    mf:notable jellyt:featureShouldLevel ;
    mf:action <select_rdf_1_1/pos_071/in.jellys> ;
    mf:result <select_rdf_1_1/pos_071/out.srj> .

<select_rdf_1_1/pos_072> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "Stream options with a stream name." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#stream-options> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_072/in.jellys> ;
    mf:result <select_rdf_1_1/pos_072/out.srj> .

<select_rdf_1_1/pos_073> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "A trailer-only final frame (row_count 0, no columns, only the trailer)." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#stream-trailer> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_073/in.jellys> ;
    mf:result <select_rdf_1_1/pos_073/out.srj> .

<select_rdf_1_1/pos_074> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "A stream without a trailer. The result set is valid; consumers should report that it may be truncated." ;
    rdfs:comment "Consumers may warn or report the missing trailer, but must not fail this test." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#stream-trailer> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_074/in.jellys> ;
    mf:result <select_rdf_1_1/pos_074/out.srj> .

<select_rdf_1_1/pos_075> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "Two streams of the same query concatenated. The second segment repeats the options (with other table sizes) and the header, and its lookup identifiers restart from 1." ;
    rdfs:comment "Blank node labels are not reset by the repeated options: the label x in both segments is one blank node." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#repeating-the-stream-options> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_075/in.jellys> ;
    mf:result <select_rdf_1_1/pos_075/out.srj> .

<select_rdf_1_1/pos_076> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "Concatenated streams in which the same variables hold values of other term types in each segment." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#repeating-the-stream-options> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_076/in.jellys> ;
    mf:result <select_rdf_1_1/pos_076/out.srj> .

<select_rdf_1_1/pos_077> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "Options repeated without a trailer before them (a producer that did not write trailers)." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#repeating-the-stream-options> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_077/in.jellys> ;
    mf:result <select_rdf_1_1/pos_077/out.srj> .

<select_rdf_1_1/pos_078> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "Five streams of the same query concatenated: different table sizes, term types, and frame counts in each segment, an empty segment, and a segment without a trailer." ;
    rdfs:comment "Lookup identifiers restart from 1 in every segment. The label x in the first and last segments is one blank node." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#repeating-the-stream-options> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_078/in.jellys> ;
    mf:result <select_rdf_1_1/pos_078/out.srj> .

<select_rdf_1_1/pos_079> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "A column of IRIs only, with no kinds, and a repeat run." ;
    rdfs:comment "kinds may be empty when all run values are of one term type." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#term-types> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/pos_079/in.jellys> ;
    mf:result <select_rdf_1_1/pos_079/out.srj> .

<select_rdf_1_1/neg_001> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "An empty file: a result stream must contain at least one frame." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#result-frames> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/neg_001/in.jellys> .

<select_rdf_1_1/neg_002> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "The last frame is truncated: the length prefix promises more bytes than the file has." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#delimited> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/neg_002/in.jellys> .

<select_rdf_1_1/neg_003> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "Version tag 0." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#stream-options> ;
    rdft:approval rdft:Proposed ;
    mf:notable jellyt:featureShouldLevel ;
    mf:action <select_rdf_1_1/neg_003/in.jellys> .

<select_rdf_1_1/neg_004> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "Version tag 2, newer than version 1 of the format." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#stream-options> ;
    rdft:approval rdft:Proposed ;
    mf:notable jellyt:featureShouldLevel ;
    mf:action <select_rdf_1_1/neg_004/in.jellys> .

<select_rdf_1_1/neg_005> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "max_name_table_size 127, below the minimum of 128." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#stream-options> ;
    rdft:approval rdft:Proposed ;
    mf:notable jellyt:featureShouldLevel ;
    mf:action <select_rdf_1_1/neg_005/in.jellys> .

<select_rdf_1_1/neg_006> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "max_name_table_size not set (0)." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#stream-options> ;
    rdft:approval rdft:Proposed ;
    mf:notable jellyt:featureShouldLevel ;
    mf:action <select_rdf_1_1/neg_006/in.jellys> .

<select_rdf_1_1/neg_007> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "max_name_table_size 10000000. Consumers should reject lookup sizes larger than their limit (recommended default 16384)." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#stream-options> ;
    rdft:approval rdft:Proposed ;
    mf:notable jellyt:featureShouldLevel ;
    mf:action <select_rdf_1_1/neg_007/in.jellys> .

<select_rdf_1_1/neg_008> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "max_prefix_table_size 10000000. Consumers should reject lookup sizes larger than their limit (recommended default 4096)." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#stream-options> ;
    rdft:approval rdft:Proposed ;
    mf:notable jellyt:featureShouldLevel ;
    mf:action <select_rdf_1_1/neg_008/in.jellys> .

<select_rdf_1_1/neg_009> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "max_datatype_table_size 10000000. Consumers should reject lookup sizes larger than their limit (recommended default 256)." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#stream-options> ;
    rdft:approval rdft:Proposed ;
    mf:notable jellyt:featureShouldLevel ;
    mf:action <select_rdf_1_1/neg_009/in.jellys> .

<select_rdf_1_1/neg_010> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "Unknown rdf_version value 4." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#rdf-version> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/neg_010/in.jellys> .

<select_rdf_1_1/neg_011> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "A prefix lookup entry when the prefix lookup is disabled (max_prefix_table_size 0)." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#stream-options> ;
    rdft:approval rdft:Proposed ;
    mf:notable jellyt:featureShouldLevel ;
    mf:action <select_rdf_1_1/neg_011/in.jellys> .

<select_rdf_1_1/neg_012> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "A datatype lookup entry when the datatype lookup is disabled (max_datatype_table_size 0)." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#stream-options> ;
    rdft:approval rdft:Proposed ;
    mf:notable jellyt:featureShouldLevel ;
    mf:action <select_rdf_1_1/neg_012/in.jellys> .

<select_rdf_1_1/neg_013> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "A name lookup entry with an identifier larger than the table size." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#stream-options> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/neg_013/in.jellys> .

<select_rdf_1_1/neg_014> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "A packed name entry whose last value falls outside the table (ids 127, 128, 129 in a table of 128)." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#packed-lookup-entries> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/neg_014/in.jellys> .

<select_rdf_1_1/neg_015> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "A prefix lookup entry with an identifier larger than the table size." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#stream-options> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/neg_015/in.jellys> .

<select_rdf_1_1/neg_016> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "A column refers to a prefix identifier outside the prefix table." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#iris> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/neg_016/in.jellys> .

<select_rdf_1_1/neg_017> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "A column refers to a name that was never defined (name_id 0 at the start of a column means 1, and the name table is empty)." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#iris> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/neg_017/in.jellys> .

<select_rdf_1_1/neg_018> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "A column refers to a name identifier outside the name table." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#iris> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/neg_018/in.jellys> .

<select_rdf_1_1/neg_019> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "A column uses prefix_ids while the prefix lookup is disabled." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#stream-options> ;
    rdft:approval rdft:Proposed ;
    mf:notable jellyt:featureShouldLevel ;
    mf:action <select_rdf_1_1/neg_019/in.jellys> .

<select_rdf_1_1/neg_020> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "prefix_ids with 2 entries for 3 values. The length must be 0, 1, or the number of values." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#iris> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/neg_020/in.jellys> .

<select_rdf_1_1/neg_021> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "A literal kind refers to a datatype identifier outside the datatype table." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#literals> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/neg_021/in.jellys> .

<select_rdf_1_1/neg_022> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "A literal kind refers to a datatype while the datatype lookup is disabled." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#stream-options> ;
    rdft:approval rdft:Proposed ;
    mf:notable jellyt:featureShouldLevel ;
    mf:action <select_rdf_1_1/neg_022/in.jellys> .

<select_rdf_1_1/neg_023> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "A literal kind refers to a datatype entry holding rdf:langString." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#literals> ;
    rdft:approval rdft:Proposed ;
    mf:notable jellyt:featureShouldLevel ;
    mf:action <select_rdf_1_1/neg_023/in.jellys> .

<select_rdf_1_1/neg_024> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "literal_kinds with 2 entries for 3 values. The length must be 0, 1, or the number of values." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#literals> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/neg_024/in.jellys> .

<select_rdf_1_1/neg_025> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "A literal kind refers to a language tag index past the end of langtags." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#literals> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/neg_025/in.jellys> .

<select_rdf_1_1/neg_026> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "A literal kind refers to a language tag, but the column has no language tags." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#literals> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/neg_026/in.jellys> .

<select_rdf_1_1/neg_027> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "A literal kind in a column with several term types refers to a language tag that is not there." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#term-types> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/neg_027/in.jellys> .

<select_rdf_1_1/neg_028> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "kinds is too short: one byte for five values." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#term-types> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/neg_028/in.jellys> .

<select_rdf_1_1/neg_029> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "kinds is too long: two bytes for two values." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#term-types> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/neg_029/in.jellys> .

<select_rdf_1_1/neg_030> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "kinds is empty, but the column has values of two term types: a literal and a blank node." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#term-types> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/neg_030/in.jellys> .

<select_rdf_1_1/neg_031> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "The unused bits of the last byte of kinds are not 0." ;
    rdfs:comment "kinds = 0x15: literal, literal, and then a third literal in the bits of a value that does not exist." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#term-types> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/neg_031/in.jellys> .

<select_rdf_1_1/neg_032> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "kinds refers to more IRIs than the column has: two IRIs, but name_ids has one." ;
    rdfs:comment "The number of kinds matches the total number of values (2), but not the number of values of each type." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#term-types> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/neg_032/in.jellys> .

<select_rdf_1_1/neg_033> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "row_count of 2^27, larger than the maximum of 2^27 - 1." ;
    rdfs:comment "The stream has zero variables, so the frame needs no columns and the row count is the only problem." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#result-frames> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/neg_033/in.jellys> .

<select_rdf_1_1/neg_034> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "A frame with more columns than the header declares variables." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#columns> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/neg_034/in.jellys> .

<select_rdf_1_1/neg_035> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "A frame with fewer columns than the header declares variables (but not zero)." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#columns> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/neg_035/in.jellys> .

<select_rdf_1_1/neg_036> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "A frame with rows but no columns, in a stream with variables." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#columns> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/neg_036/in.jellys> .

<select_rdf_1_1/neg_037> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "A zero-variable result set with a column." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#zero-variable-result-sets> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/neg_037/in.jellys> .

<select_rdf_1_1/neg_038> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "A header in the second frame of the result set, identical to the first header. The header may only be in the first frame of a result set, or in a frame with the stream options." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#result-set-header> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/neg_038/in.jellys> .

<select_rdf_1_1/neg_039> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "kinds refers to more literals than the column has: two literals, but lex_values has one." ;
    rdfs:comment "The number of kinds matches the total number of values (2), but not the number of values of each type." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#term-types> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/neg_039/in.jellys> .

<select_rdf_1_1/neg_040> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "kinds refers to more blank nodes than the column has: two blank nodes, but bnodes has one." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#term-types> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/neg_040/in.jellys> .

<select_rdf_1_1/neg_041> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "prefix_ids with one entry per run value, in a column with two IRIs and a literal. The list must have 0, 1, or one entry per IRI." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#iris> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/neg_041/in.jellys> .

<select_rdf_1_1/neg_042> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "literal_kinds with one entry per run value, in a column with two literals and an IRI. The list must have 0, 1, or one entry per literal." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#literals> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/neg_042/in.jellys> .

<select_rdf_1_1/neg_043> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "The stream options are repeated, but the frame does not repeat the header. An empty header next to the options declares zero variables, which does not match the first header." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#repeating-the-stream-options> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/neg_043/in.jellys> .

<select_rdf_1_1/neg_044> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "The stream options are repeated with a header declaring other variables than the first header." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#repeating-the-stream-options> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/neg_044/in.jellys> .

<select_rdf_1_1/neg_045> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "The repeated stream options are not valid on their own (max_name_table_size 10)." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#repeating-the-stream-options> ;
    rdft:approval rdft:Proposed ;
    mf:notable jellyt:featureShouldLevel ;
    mf:action <select_rdf_1_1/neg_045/in.jellys> .

<select_rdf_1_1/neg_046> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "After the options are repeated, a column refers to a name defined only before the reset. The lookups are emptied by the reset." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#repeating-the-stream-options> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/neg_046/in.jellys> .

<select_rdf_1_1/neg_047> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "Corrupt layout: skip runs past the last run value." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#sequence-layout> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/neg_047/in.jellys> .

<select_rdf_1_1/neg_048> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "Corrupt layout: a repeat run starts after the last run value." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#sequence-layout> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/neg_048/in.jellys> .

<select_rdf_1_1/neg_049> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "Corrupt layout: len_code 15 is the last token, with no extension varint after it." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#sequence-layout> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/neg_049/in.jellys> .

<select_rdf_1_1/neg_050> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "Corrupt layout: a repeat run makes the column longer than row_count." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#sequence-layout> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/neg_050/in.jellys> .

<select_rdf_1_1/neg_051> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "Corrupt layout: an unbound run makes the column longer than row_count." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#sequence-layout> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/neg_051/in.jellys> .

<select_rdf_1_1/neg_052> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "A column with more run values than row_count, and no layouts." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#sequence-layout> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/neg_052/in.jellys> .

<select_rdf_1_1/neg_053> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "Corrupt layout: an extension varint of 2^32 - 1 (a run far longer than the frame)." ;
    rdfs:comment "Consumers should check the run length against row_count before writing any cells (see the security considerations)." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#sequence-layout> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/neg_053/in.jellys> .

<select_rdf_1_1/neg_054> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "A trailer with an error. The rows before it are valid, but the result set is incomplete and the consumer must signal an error." ;
    rdfs:comment "Implementations may deliver the two rows before the error, but must signal the error to the caller." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#stream-trailer> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/neg_054/in.jellys> .

<select_rdf_1_1/neg_055> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "Concatenated streams: the first segment ends with an error trailer, the second with a trailer without an error. Repeating the stream options does not cancel the error." ;
    rdfs:comment "Implementations may deliver the rows, but must signal the error to the caller." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#stream-trailer> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/neg_055/in.jellys> .

<select_rdf_1_1/neg_056> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "A frame without the stream options after a frame with a trailer." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#stream-trailer> ;
    rdft:approval rdft:Proposed ;
    mf:notable jellyt:featureShouldLevel ;
    mf:action <select_rdf_1_1/neg_056/in.jellys> .

<select_rdf_1_1/neg_057> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "A boolean result in the second frame of a stream of solutions." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#boolean-results> ;
    rdft:approval rdft:Proposed ;
    mf:notable jellyt:featureShouldLevel ;
    mf:action <select_rdf_1_1/neg_057/in.jellys> .

<select_rdf_1_1/neg_058> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "An unknown stream_type value." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#stream-types> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/neg_058/in.jellys> .

