    mf:action <select_rdf_1_2_basic/neg_001/in.jellys> .

<select_rdf_1_2_basic/neg_002> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "langtag_directions set in a column with no language tags." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#literals> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementRdf12Basic ;
    mf:action <select_rdf_1_2_basic/neg_002/in.jellys> .

<select_rdf_1_2_basic/neg_003> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
