    mf:action <select_rdf_1_1/neg_013/in.jellys> .

<select_rdf_1_1/neg_014> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "A packed name entry whose last value falls outside the table (ids 127, 128, 129 in a table of 128)." ;
