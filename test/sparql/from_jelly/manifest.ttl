    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/neg_027/in.jellys> .

<select_rdf_1_1/neg_028> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "A literal column in the full form (lex_values empty) that sets langtag." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#literal-columns> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/neg_028/in.jellys> .

<select_rdf_1_1/neg_029> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "A literal column in the lexical form that sets both datatype and langtag." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#literal-columns> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/neg_029/in.jellys> .

<select_rdf_1_1/neg_030> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "A term in a polymorphic column with no field of the oneof set." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#polymorphic-columns> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/neg_030/in.jellys> .

<select_rdf_1_1/neg_031> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "row_count of 2^27, larger than the maximum of 2^27 - 1." ;
    rdfs:comment "The stream has zero variables, so the frame needs no columns and the row count is the only problem." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#result-frames> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/neg_031/in.jellys> .

<select_rdf_1_1/neg_032> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "A frame with more columns than the header declares variables." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#column-indices> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/neg_032/in.jellys> .

<select_rdf_1_1/neg_033> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "A frame with fewer columns than the header declares variables (but not zero)." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#column-indices> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/neg_033/in.jellys> .

<select_rdf_1_1/neg_034> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "A frame with rows but no columns, in a stream with variables." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#column-indices> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/neg_034/in.jellys> .

<select_rdf_1_1/neg_035> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "A zero-variable result set with a column." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#zero-variable-result-sets> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/neg_035/in.jellys> .

<select_rdf_1_1/neg_036> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "Two variables mapped to the same column index." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#column-indices> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/neg_036/in.jellys> .

<select_rdf_1_1/neg_037> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "A column index outside the columns of the frame." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#column-indices> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/neg_037/in.jellys> .

<select_rdf_1_1/neg_038> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "A restated header with a different variable name." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#restating-the-header> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/neg_038/in.jellys> .

<select_rdf_1_1/neg_039> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "A restated header with the variables in a different order." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#restating-the-header> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/neg_039/in.jellys> .

<select_rdf_1_1/neg_040> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "A restated header with fewer variables." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#restating-the-header> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/neg_040/in.jellys> .

<select_rdf_1_1/neg_041> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "The stream options are repeated, but the frame does not restate the header. An empty header next to the options declares zero variables, which does not match the first header." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#repeating-the-stream-options> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/neg_041/in.jellys> .

<select_rdf_1_1/neg_042> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "The stream options are repeated with a header declaring other variables than the first header." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#repeating-the-stream-options> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/neg_042/in.jellys> .

<select_rdf_1_1/neg_043> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "The repeated stream options are not valid on their own (max_name_table_size 10)." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#repeating-the-stream-options> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/neg_043/in.jellys> .

<select_rdf_1_1/neg_044> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "After the options are repeated, a column refers to a name defined only before the reset. The lookups are emptied by the reset." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#repeating-the-stream-options> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/neg_044/in.jellys> .

<select_rdf_1_1/neg_045> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "Corrupt layout: skip runs past the last run value." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#sequence-layout> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/neg_045/in.jellys> .

<select_rdf_1_1/neg_046> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "Corrupt layout: a repeat run starts after the last run value." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#sequence-layout> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/neg_046/in.jellys> .

<select_rdf_1_1/neg_047> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "Corrupt layout: len_code 15 is the last token, with no extension varint after it." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#sequence-layout> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/neg_047/in.jellys> .

<select_rdf_1_1/neg_048> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "Corrupt layout: a repeat run makes the column longer than row_count." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#sequence-layout> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/neg_048/in.jellys> .

<select_rdf_1_1/neg_049> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "Corrupt layout: an unbound run makes the column longer than row_count." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#sequence-layout> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/neg_049/in.jellys> .

<select_rdf_1_1/neg_050> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "A column with more run values than row_count, and no layouts." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#sequence-layout> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/neg_050/in.jellys> .

<select_rdf_1_1/neg_051> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "Corrupt layout: an extension varint of 2^32 - 1 (a run far longer than the frame)." ;
    rdfs:comment "Consumers must check the run length against row_count before writing any cells." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#column-layouts> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/neg_051/in.jellys> .

<select_rdf_1_1/neg_052> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "A trailer with an error. The rows before it are valid, but the result set is incomplete and the consumer must report it." ;
    rdfs:comment "Implementations may deliver the two rows before the error, but must signal the error to the caller." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#stream-trailer> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/neg_052/in.jellys> .

<select_rdf_1_1/neg_053> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "A frame without the stream options after a frame with a trailer." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#stream-trailer> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/neg_053/in.jellys> .

<select_rdf_1_1/neg_054> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "A boolean result in the second frame of a stream of solutions." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#boolean-results> ;
    rdft:approval rdft:Proposed ;
    mf:action <select_rdf_1_1/neg_054/in.jellys> .

