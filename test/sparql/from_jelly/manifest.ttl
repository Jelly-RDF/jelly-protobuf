    rdft:approval rdft:Proposed ;
    mf:action <ask/pos_003/in.jellys> ;
    mf:result <ask/pos_003/out.srj> .

<ask/pos_004> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "Boolean result without a trailer." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#boolean-results> ;
    rdft:approval rdft:Proposed ;
    mf:action <ask/pos_004/in.jellys> ;
    mf:result <ask/pos_004/out.srj> .

<ask/neg_001> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
