    mf:action <select_rdf_1_1/neg_012/in.jellys> .

<select_rdf_1_1/neg_013> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "A name lookup entry with an identifier larger than the table size." ;
