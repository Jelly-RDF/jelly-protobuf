<select_rdf_1_1/neg_009> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "max_datatype_table_size 10000000. Consumers must limit the lookup sizes they accept (recommended default 256)." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#overly-large-lookup-tables> ;
    rdft:approval rdft:Proposed ;
    mf:notable jellyt:featureShouldLevel ;
