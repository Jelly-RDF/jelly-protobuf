    mf:action <ask/neg_002/in.jellys> .

<ask/neg_003> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "A boolean result frame with row_count 1." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#boolean-results> ;
    rdft:approval rdft:Proposed ;
    mf:notable jellyt:featureShouldLevel ;
    mf:action <ask/neg_003/in.jellys> .

<ask/neg_004> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "A frame follows the boolean result." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#boolean-results> ;
    rdft:approval rdft:Proposed ;
    mf:notable jellyt:featureShouldLevel ;
    mf:action <ask/neg_004/in.jellys> .

<ask/neg_005> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "A second boolean result stream concatenated after the first. Boolean results cannot be concatenated." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#boolean-results> ;
    rdft:approval rdft:Proposed ;
    mf:notable jellyt:featureShouldLevel ;
    mf:action <ask/neg_005/in.jellys> .

<ask/neg_006> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "A boolean result with an error trailer." ;
