    mf:action <select_rdf_1_2/neg_007/in.jellys> .

<select_rdf_1_2/neg_008> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "A literal in a triple term whose datatype is rdf:langString." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#literals-in-triple-terms> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementRdf12 ;
    mf:notable jellyt:featureShouldLevel ;
    mf:action <select_rdf_1_2/neg_008/in.jellys> .

<select_rdf_1_2/neg_009> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "A literal in a triple term whose datatype is rdf:dirLangString." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#literals-in-triple-terms> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementRdf12 ;
    mf:notable jellyt:featureShouldLevel ;
    mf:action <select_rdf_1_2/neg_009/in.jellys> .

<select_rdf_1_2/neg_010> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "kinds is empty, but the column has values of two term types: an IRI and a triple term." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#term-types> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementRdf12 ;
    mf:action <select_rdf_1_2/neg_010/in.jellys> .

<punctuated/pos_001> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "A single result set in a PUNCTUATED stream." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#stream-types> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPunctuated ;
    mf:action <punctuated/pos_001/in.jellys> ;
    mf:result (
        <punctuated/pos_001/out_000.srj>
    ) .

<punctuated/pos_002> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "Two result sets with different variables. The second one starts without the stream options and refers to names defined in the first one: the lookups are kept between result sets." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#stream-types> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPunctuated ;
    mf:action <punctuated/pos_002/in.jellys> ;
    mf:result (
        <punctuated/pos_002/out_000.srj>
        <punctuated/pos_002/out_001.srj>
    ) .

<punctuated/pos_003> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "A result set over three frames, in which the variable changes term type, followed by another result set." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#stream-types> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPunctuated ;
    mf:action <punctuated/pos_003/in.jellys> ;
    mf:result (
        <punctuated/pos_003/out_000.srj>
        <punctuated/pos_003/out_001.srj>
    ) .

<punctuated/pos_004> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "Boolean results and a solution sequence mixed in one stream." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#stream-types> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPunctuated ;
    mf:action <punctuated/pos_004/in.jellys> ;
    mf:result (
        <punctuated/pos_004/out_000.srj>
        <punctuated/pos_004/out_001.srj>
        <punctuated/pos_004/out_002.srj>
    ) .

<punctuated/pos_005> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "A frame with a boolean result also has lookup entries, which the next result set uses." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#prefix-name-and-datatype-lookup-entries> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPunctuated ;
    mf:action <punctuated/pos_005/in.jellys> ;
    mf:result (
        <punctuated/pos_005/out_000.srj>
        <punctuated/pos_005/out_001.srj>
    ) .

<punctuated/pos_006> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "The same blank node label in two result sets." ;
    rdfs:comment "Blank node labels are scoped to a single result set, so the two cells are different blank nodes. Result sets are compared one at a time, so this test does not check that a consumer keeps them apart." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#blank-nodes> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPunctuated ;
    mf:action <punctuated/pos_006/in.jellys> ;
    mf:result (
        <punctuated/pos_006/out_000.srj>
        <punctuated/pos_006/out_001.srj>
    ) .

<punctuated/pos_007> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "Stream options repeated in the first frame of a result set: the lookups are emptied, and their identifiers restart from 1." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#repeating-the-stream-options> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPunctuated ;
    mf:action <punctuated/pos_007/in.jellys> ;
    mf:result (
        <punctuated/pos_007/out_000.srj>
        <punctuated/pos_007/out_001.srj>
    ) .

<punctuated/pos_008> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "A zero-variable result set and an empty result set between two others. An empty header in the first frame of a result set declares zero variables." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#zero-variable-result-sets> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPunctuated ;
    mf:action <punctuated/pos_008/in.jellys> ;
    mf:result (
        <punctuated/pos_008/out_000.srj>
        <punctuated/pos_008/out_001.srj>
        <punctuated/pos_008/out_002.srj>
        <punctuated/pos_008/out_003.srj>
    ) .

<punctuated/pos_009> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "The last result set has no trailer." ;
    rdfs:comment "Consumers may report the last result set as possibly truncated, but must not fail this test." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#stream-trailer> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPunctuated ;
    mf:action <punctuated/pos_009/in.jellys> ;
    mf:result (
        <punctuated/pos_009/out_000.srj>
        <punctuated/pos_009/out_001.srj>
    ) .

<punctuated/pos_010> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "Links in two result sets: each applies only to its own result set." ;
    rdfs:comment "The equivalence of result sets does not cover links. Implementations that expose links should check that each result set has only its own link." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#well-known-metadata-keys> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPunctuated ;
    mf:action <punctuated/pos_010/in.jellys> ;
    mf:result (
        <punctuated/pos_010/out_000.srj>
        <punctuated/pos_010/out_001.srj>
    ) .

<punctuated/pos_011> a jellyt:TestPositive, jellyt:TestSparqlFromJelly ;
    mf:name "Two PUNCTUATED streams concatenated: the result sets of both, in order." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#stream-types> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPunctuated ;
    mf:action <punctuated/pos_011/in.jellys> ;
    mf:result (
        <punctuated/pos_011/out_000.srj>
        <punctuated/pos_011/out_001.srj>
        <punctuated/pos_011/out_002.srj>
    ) .

<punctuated/neg_001> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "The stream options in a frame that is not the first frame of a result set." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#stream-types> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPunctuated ;
    mf:action <punctuated/neg_001/in.jellys> .

<punctuated/neg_002> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "The first frame of the second result set has a column, but no header. An empty header there declares zero variables." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#zero-variable-result-sets> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPunctuated ;
    mf:action <punctuated/neg_002/in.jellys> .

<punctuated/neg_003> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "A boolean result in the second frame of a result set." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#boolean-results> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPunctuated ;
    mf:notable jellyt:featureShouldLevel ;
    mf:action <punctuated/neg_003/in.jellys> .

<punctuated/neg_004> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "A frame follows a boolean result that has no trailer." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#boolean-results> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPunctuated ;
    mf:notable jellyt:featureShouldLevel ;
    mf:action <punctuated/neg_004/in.jellys> .

<punctuated/neg_005> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "A header in the second frame of the second result set." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#result-set-header> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPunctuated ;
    mf:action <punctuated/neg_005/in.jellys> .

<punctuated/neg_006> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "The stream type changes from FLAT to PUNCTUATED when the stream options are repeated." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#stream-types> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPunctuated ;
    mf:action <punctuated/neg_006/in.jellys> .

<punctuated/neg_007> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "The stream type changes from PUNCTUATED to FLAT when the stream options are repeated." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#stream-types> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPunctuated ;
    mf:action <punctuated/neg_007/in.jellys> .

<punctuated/neg_008> a jellyt:TestNegative, jellyt:TestSparqlFromJelly ;
    mf:name "An error trailer in the first of two result sets." ;
    rdfs:comment "The error applies only to the first result set. Implementations may go on with the next result set, but must signal the error to the caller." ;
    rdfs:seeAlso <https://w3id.org/jelly/dev/specification/sparql/#stream-trailer> ;
    rdft:approval rdft:Proposed ;
    mf:requires jellyt:requirementPunctuated ;
    mf:action <punctuated/neg_008/in.jellys> .
